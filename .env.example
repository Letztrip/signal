GCP_PROJECT=letztrip-production-account
PUBSUB_TOPIC=events-raw
LOG_LEVEL=debug

# --- Auth source for write keys (pick ONE) ---
#
# (a) Local dev — inline plaintext keys. Format: "<app-id>:<plaintext-key>"
#     entries separated by newline or comma. The collector hashes them at
#     startup so the verify path stays argon2id-based. NEVER USE IN PROD.
WRITE_KEYS_PLAINTEXT=demo-app:dev-write-key-change-me
#
# (b) Production — Secret Manager (PHC-hashed, rotated via versions).
#     Comment (a) and uncomment (b) when you're ready.
# WRITE_KEYS_SECRET=projects/letztrip-production-account/secrets/write-keys/versions/latest

# Path to the SA key on the host. Defaults to the key file in the repo root,
# created by scripts/create-service-account.sh.
GOOGLE_APPLICATION_CREDENTIALS_HOST=./collector-vm-key.json
